[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/hud/ResourceBar.gd" id="1"]

[node name="ResourceBar" type="HBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="BudgetDisplay" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="BudgetIcon" type="Label" parent="BudgetDisplay"]
layout_mode = 2
text = "Budget:"

[node name="BudgetValue" type="Label" parent="BudgetDisplay"]
layout_mode = 2
text = "$50,000"

[node name="VSeparator" type="VSeparator" parent="."]
layout_mode = 2

[node name="CapacityDisplay" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="CapacityIcon" type="Label" parent="CapacityDisplay"]
layout_mode = 2
text = "Capacity:"

[node name="CapacityValue" type="Label" parent="CapacityDisplay"]
layout_mode = 2
text = "12 pw"
